[merge]
	tool = code
[mergetool "code"]
	cmd = code --wait --merge \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\"
[mergetool]
	prompt = false
  keepBackup = false
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    side-by-side = true
    line-numbers = true
    navigate = true
    dark = true

    syntax-theme = Dracula     

    file-style = "#ebfafa" bold none
    file-decoration-style = "#a48cf2" box ul

    hunk-header-style = "#04d1f9" bold
    hunk-header-decoration-style = "#323449" box

    line-numbers-minus-style = "#f16c75"
    line-numbers-plus-style = "#37f499"
    line-numbers-left-style = "#323449"
    line-numbers-right-style = "#323449"
[fetch]
  prune = true
[pull]
  rebase = true
[init]
  defaultBranch = main
[alias]
  tree = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
[include]
    path = ~/.gitconfig.local
