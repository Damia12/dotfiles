# Los hooks y los scripts se ejecutan en Linux: tienen que conservar LF aunque
# se editen o se clonen desde Windows (esta maquina tiene core.autocrlf=true).
# Con CRLF, bash falla con "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf
.zshrc text eol=lf
.p10k.zsh text eol=lf

# El perfil de PowerShell vive del lado Windows.
*.ps1 text eol=crlf

# Los hooks de Windows son batch: cmd necesita CRLF, con LF falla de forma
# erratica en etiquetas, goto y bloques entre parentesis.
*.cmd text eol=crlf
*.bat text eol=crlf
